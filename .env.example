LIBRECHAT_WEB_HOST=librechat-web
LIBRECHAT_WEB_PORT=3080
LIBRECHAT_WEB_IMAGE=registry.librechat.ai/librechat-ai/librechat-dev:latest
LIBRECHAT_WEB_KEYCLOAK_CLIENT_ID=librechat
LIBRECHAT_WEB_KEYCLOAK_CLIENT_SECRET=
LIBRECHAT_WEB_KEYCLOAK_SESSION_SECRET=

LIBRECHAT_ADMIN_PANEL_HOST=librechat-admin-panel
